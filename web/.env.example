# Names only. No secrets belong here; the web app holds no keys (the wallet signs).
# The app is testnet-only. There is no mode switch. All values are optional and default to the
# public testnet deployment in src/lib/deployment.json.
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_REVVAULT_CONTRACT_ID=revvault.revvault-dep-17094.testnet
VITE_USDC_CONTRACT_ID=usdc.revvault-dep-17094.testnet
# optional: show only one demo business account in the business switcher
VITE_DEMO_BUSINESS_ID=
